{
  "name": "google-drive-webdav-workers",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "build": "wrangler build",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:e2e": "vitest run --config test/e2e/vitest.config.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test --run",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "~4.1.5",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
