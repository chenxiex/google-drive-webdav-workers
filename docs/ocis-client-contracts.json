    "status_php": {
      "request": "GET https://dav.example.com/status.php",
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "body": {
          "installed": true,
          "maintenance": false,
          "needsDbUpgrade": false,
          "version": "10.11.0.0",
          "versionstring": "10.11.0",
          "edition": "Community",
          "productname": "Infinite Scale",
          "product": "Infinite Scale",
          "productversion": "8.2.3"
        }
      },
      "notes": "Both version and productversion must be non-blank strings: Android StatusRequester.kt:104 reads both via JSONObject.getString and OpenCloudVersion.kt:54,68 requires non-blank productversion. Desktop checkserverjobfactory.cpp:127-156 forbids redirects and requires installed."
    },
    "webfinger": {
      "request": "GET https://dav.example.com/.well-known/webfinger?resource=...",
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8"
        },
        "body": "Not Found"
      },
      "notes": "Single-instance Worker profile intentionally returns 404 for WebFinger: both Desktop (urlpagecontroller.cpp:223) and Android (OCServerInfoRepository.kt:87) fall back directly to single-instance status.php + OIDC discovery. (If multi-instance WebFinger 200 is ever added later, Desktop requires Content-Type containing application/json, matching subject, and authenticated GET ?resource=acct:me@<host> returning rel=http://webfinger.owncloud/rel/server-instance.)"
    },
