    "oc_permissions": {
      "desktop_allowed_letters": " WDNVCKRSMmz",
      "contract": "Must be non-empty on files and folders (Desktop propagateuploadcommon.cpp:373 triggers extra PROPFIND or FatalError when null; discoveryphase.cpp:357 warns if share-types lacks permissions). Example writable values: RDNVW (file), RDNVCK (folder), R (read-only)."
    },
    "oc_has_preview": {
      "values": [
        "1",
        "0"
      ],
      "contract": "Android OCHasPreview.kt:44 strictly checks `text == \"1\"`; never emit \"true\" or \"false\"."
    },
    "oc_checksums": {
      "format": "<oc:checksums><oc:checksum>SHA1:<hex> MD5:<hex> SHA256:<hex></oc:checksum></oc:checksums>",
      "notes": "Verified against Android OCChecksums.kt:38-58 and Desktop discoveryphase.cpp:348-350."
    },
    "tus_head_without_version_header": {
      "contract": "Desktop journal resume (propagateuploadtus.cpp:123) sends `HEAD <location>` WITHOUT `Tus-Resumable`; server MUST tolerate missing `Tus-Resumable` on TUS HEAD while returning 412 when a non-empty unsupported version is sent."
    },
    "tus_extensions_and_headers": {
      "tus_extension": "creation,creation-with-upload,checksum",
      "tus_checksum_algorithm": "sha1,md5,sha256",
      "notes": "Advertise checksum alongside creation,creation-with-upload on TUS OPTIONS/responses (termination/expiration remain unadvertised), while keeping OCS files.tus_support.extension as creation,creation-with-upload matching oCIS 8.2.3. Per-chunk Upload-Checksum is validated via Workers Web Crypto crypto.subtle.digest before flushing to Drive (460 on mismatch)."
    },
    "tus_checksums_and_chunks": {
      "desktop_upload_metadata": "filename=<relative subpath>, checksum=\"SHA1 <hex>\", mtime=<integer Unix seconds>; creation-with-upload POST size min(remaining, max_chunk_size); reads ETag, OC-Perm, OC-FileID from completion response (falls back to PROPFIND Depth: 0).",
      "rclone_tus_post": "rclone 1.76.0 sends whole-file OC-Checksum: SHA1:<hex> on TUS POST (wire-10485760.json #68) in addition to Upload-Metadata.",
      "android_upload_threshold_bytes": 10240000,
      "android_plain_put": "For files < 10,240,000 B, Android uses PUT with X-OC-Mtime, OC-Total-Length, optional If-Match, and OC-Checksum: SHA1:<hex> (UploadFileFromFileSystemOperation.kt:108-113).",
      "android_tus_upload": "For files >= 10,240,000 B, Android POSTs to <spaceWebDavUrl>/<parentDir> (no trailing slash) with filename=<basename>, mimetype, mtime, checksum=\"SHA1 <hex>\", first chunk min(10 MiB, fileSize, max_chunk_size), subsequent PATCHes min(10,240,000, remaining, max_chunk_size) (10,240,000 % 262,144 = 16,384 B remainder). Both data-bearing POST and PATCH include per-chunk `Upload-Checksum: sha1 <base64>` (TusChecksumHelper.kt:119-125). Android fast-fails and clears TUS state on HTTP 400 or 460 (TusUploadHelper.kt:283-288,373-374)."
    },
    "conflict_status_412": {
      "contract": "Both Desktop 7.1.1 (propagateuploadcommon.cpp:252) and Android 1.3.1 (RemoteOperationResult.java:252-255) map HTTP 412 Precondition Failed on If-Match mismatch natively to conflict/rediscovery."
    },
    "android_preview": {
      "file_preview_url": "GET <spaceWebDavUrl><encodedPath>?x=<width>&y=<height>&c=<etag>&preview=1",
      "headers": {
        "Authorization": "Bearer <token>",
        "Accept-Encoding": "identity"
      },
      "avatar_url": "GET /graph/v1.0/me/photo/$value (404 acceptable when files_sharing.user.profile_picture=false)"
    }
