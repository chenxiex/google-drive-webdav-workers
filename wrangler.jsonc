{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "google-drive-webdav-workers",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-15",
	"upload_source_maps": false,
	"send_metrics": false,
	"keep_names": false,
	"minify": true,
	"durable_objects": {
		"bindings": [
			{ "name": "TUS_UPLOADS", "class_name": "TusUpload" },
			{ "name": "AUTH_DO", "class_name": "AuthStore" },
			{ "name": "SYNC_INDEX", "class_name": "SyncIndex" }
		]
	},
	"migrations": [
		{ "tag": "v1-tus", "new_sqlite_classes": ["TusUpload"] },
		{ "tag": "v2-auth", "new_sqlite_classes": ["AuthStore"] },
		{ "tag": "v3-sync", "new_sqlite_classes": ["SyncIndex"] }
	]
}
