{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "google-drive-webdav-workers",
	"main": "src/worker.ts",
	"compatibility_date": "2026-04-15",
	"upload_source_maps": false,
	"send_metrics": false,
	"keep_names": false,
	"minify": true,
	"durable_objects": { "bindings": [{ "name": "TUS_UPLOADS", "class_name": "TusUpload" }] },
	"migrations": [{ "tag": "v1-tus", "new_sqlite_classes": ["TusUpload"] }],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "google-drive-webdav-kv"
		}
	]
}