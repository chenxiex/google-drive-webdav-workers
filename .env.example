# Supply your own OAuth client pair and a refresh token issued to that client.
# Placeholder values below are not usable credentials. Never commit real secrets.
REFRESH_TOKEN="your-refresh-token"
CLIENT_ID="your-own-client-id.apps.googleusercontent.com"
CLIENT_SECRET="your-own-client-secret"
WEBDAV_PATH="/webdav/"
ROOT_ID="root"
USERS={"user":"password"}
NAME="My Cloud Drive"

# Optional Cloudflare Access + OIDC/OAuth adapter (auto-activates when set; omit for Basic-only mode)
# CF_ACCESS_AUD="your-cloudflare-access-application-aud"
# CF_ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
# Accepts single-line base64 PKCS#8 DER/PEM, multi-line quoted PEM, or private JWK JSON
# OIDC_SIGNING_KEY="MIIEvQIBADANBg..."
# OIDC_SIGNING_KID=""
# PUBLIC_ORIGIN="https://dav.example.com"
